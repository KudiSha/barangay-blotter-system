        <mxCell id="sch_users" value="&lt;b&gt;users&lt;/b&gt;&lt;table border=&#39;1&#39; width=&#39;100%&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse&#39;&gt;&lt;tr bgcolor=&#39;#dae8fc&#39;&gt;&lt;th&gt;Column&lt;/th&gt;&lt;th&gt;Data Type&lt;/th&gt;&lt;th&gt;Key&lt;/th&gt;&lt;th&gt;Null&lt;/th&gt;&lt;th&gt;Default / Constraint / Index&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;user_id&lt;/td&gt;&lt;td&gt;INT&lt;/td&gt;&lt;td&gt;PK&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;AUTO_INCREMENT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;username&lt;/td&gt;&lt;td&gt;VARCHAR(50)&lt;/td&gt;&lt;td&gt;UNIQUE&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;password_hash&lt;/td&gt;&lt;td&gt;CHAR(64)&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;SHA-256 hash (hex)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;full_name&lt;/td&gt;&lt;td&gt;VARCHAR(100)&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=12;strokeColor=#000000;fillColor=#ffffff;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="sch_person" value="&lt;b&gt;person&lt;/b&gt;&lt;table border=&#39;1&#39; width=&#39;100%&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse&#39;&gt;&lt;tr bgcolor=&#39;#dae8fc&#39;&gt;&lt;th&gt;Column&lt;/th&gt;&lt;th&gt;Data Type&lt;/th&gt;&lt;th&gt;Key&lt;/th&gt;&lt;th&gt;Null&lt;/th&gt;&lt;th&gt;Default / Constraint / Index&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;person_id&lt;/td&gt;&lt;td&gt;INT&lt;/td&gt;&lt;td&gt;PK&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;AUTO_INCREMENT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;full_name&lt;/td&gt;&lt;td&gt;VARCHAR(150)&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;INDEX idx_person_name&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;address&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;YES&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;contact_no&lt;/td&gt;&lt;td&gt;VARCHAR(20)&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;YES&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=12;strokeColor=#000000;fillColor=#ffffff;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="60" width="640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="sch_blotter" value="&lt;b&gt;blotter&lt;/b&gt;&lt;table border=&#39;1&#39; width=&#39;100%&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse&#39;&gt;&lt;tr bgcolor=&#39;#dae8fc&#39;&gt;&lt;th&gt;Column&lt;/th&gt;&lt;th&gt;Data Type&lt;/th&gt;&lt;th&gt;Key&lt;/th&gt;&lt;th&gt;Null&lt;/th&gt;&lt;th&gt;Default / Constraint / Index&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;blotter_id&lt;/td&gt;&lt;td&gt;INT&lt;/td&gt;&lt;td&gt;PK&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;AUTO_INCREMENT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;blotter_no&lt;/td&gt;&lt;td&gt;VARCHAR(30)&lt;/td&gt;&lt;td&gt;UNIQUE&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;UNIQUE (format YYYY-NNNN)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;case_type&lt;/td&gt;&lt;td&gt;VARCHAR(50)&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;incident_date&lt;/td&gt;&lt;td&gt;DATE&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;INDEX idx_blotter_date&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;incident_place&lt;/td&gt;&lt;td&gt;VARCHAR(255)&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;narrative&lt;/td&gt;&lt;td&gt;TEXT&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;YES&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;status&lt;/td&gt;&lt;td&gt;VARCHAR(30)&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;DEFAULT &#39;Pending&#39;; CHECK chk_blotter_status IN (&#39;Pending&#39;,&#39;For Hearing&#39;,&#39;Settled&#39;,&#39;Referred to Police&#39;); INDEX idx_blotter_status&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=12;strokeColor=#000000;fillColor=#ffffff;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="280" width="640" height="300" as="geometry" />
        </mxCell>
        <mxCell id="sch_involved" value="&lt;b&gt;involved&lt;/b&gt;&lt;table border=&#39;1&#39; width=&#39;100%&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse&#39;&gt;&lt;tr bgcolor=&#39;#dae8fc&#39;&gt;&lt;th&gt;Column&lt;/th&gt;&lt;th&gt;Data Type&lt;/th&gt;&lt;th&gt;Key&lt;/th&gt;&lt;th&gt;Null&lt;/th&gt;&lt;th&gt;Default / Constraint / Index&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;involved_id&lt;/td&gt;&lt;td&gt;INT&lt;/td&gt;&lt;td&gt;PK&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;AUTO_INCREMENT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;blotter_id&lt;/td&gt;&lt;td&gt;INT&lt;/td&gt;&lt;td&gt;FK&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;fk_involved_blotter: blotter(blotter_id) ON DELETE CASCADE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;person_id&lt;/td&gt;&lt;td&gt;INT&lt;/td&gt;&lt;td&gt;FK&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;fk_involved_person: person(person_id) ON DELETE RESTRICT; INDEX idx_involved_person&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;role&lt;/td&gt;&lt;td&gt;VARCHAR(20)&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;CHECK chk_involved_role IN (&#39;Complainant&#39;,&#39;Respondent&#39;)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Table constraint: UNIQUE uq_involved (blotter_id, person_id, role)" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=12;strokeColor=#000000;fillColor=#ffffff;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="280" width="640" height="300" as="geometry" />
        </mxCell>
        <mxCell id="sch_hearing" value="&lt;b&gt;hearing&lt;/b&gt;&lt;table border=&#39;1&#39; width=&#39;100%&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse&#39;&gt;&lt;tr bgcolor=&#39;#dae8fc&#39;&gt;&lt;th&gt;Column&lt;/th&gt;&lt;th&gt;Data Type&lt;/th&gt;&lt;th&gt;Key&lt;/th&gt;&lt;th&gt;Null&lt;/th&gt;&lt;th&gt;Default / Constraint / Index&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;hearing_id&lt;/td&gt;&lt;td&gt;INT&lt;/td&gt;&lt;td&gt;PK&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;AUTO_INCREMENT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;blotter_id&lt;/td&gt;&lt;td&gt;INT&lt;/td&gt;&lt;td&gt;FK&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;fk_hearing_blotter: blotter(blotter_id) ON DELETE CASCADE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;hearing_date&lt;/td&gt;&lt;td&gt;DATE&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;INDEX idx_hearing_date&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;hearing_time&lt;/td&gt;&lt;td&gt;TIME&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;venue&lt;/td&gt;&lt;td&gt;VARCHAR(150)&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;lupon_panel&lt;/td&gt;&lt;td&gt;VARCHAR(150)&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;NO&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;fontSize=12;strokeColor=#000000;fillColor=#ffffff;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="610" width="640" height="250" as="geometry" />
        </mxCell>
        <mxCell id="sch_view" value="&lt;b&gt;View: v_summon_letter&lt;/b&gt;&lt;br&gt;&lt;br&gt;Columns: hearing_id, blotter_id, blotter_no, case_type, full_name, address, role, hearing_date, hearing_time, venue, lupon_panel&lt;br&gt;&lt;br&gt;Built from: hearing h JOIN blotter b JOIN involved i JOIN person p (joined through blotter_id and person_id).&lt;br&gt;&lt;br&gt;Used by the program to build the summon letter after a hearing is saved." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;strokeColor=#000000;fillColor=#ffffff;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="700" y="610" width="640" height="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
